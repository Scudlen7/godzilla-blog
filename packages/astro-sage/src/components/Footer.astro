---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@sage/utils/withBase";
import Socials from "./Socials.astro";
import config from "@sage/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const english = locale === "en";
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border text-muted-foreground flex flex-col items-center justify-between gap-3 border-t py-8 text-sm sm:flex-row">
    <p>
      © {currentYear} {config.site.author}
    </p>
    <nav
      class="flex flex-wrap items-center justify-center gap-4"
      aria-label={english ? "Footer" : "页脚导航"}
    >
      <Socials />
      <a
        class="hover:underline"
        href={getRelativeLocaleUrl(locale, "contribute")}
      >
        {english ? "Contribute" : "投稿"}
      </a>
      <a class="hover:underline" href={getAssetPath("rss.xml")}>
        RSS
      </a>
      <a class="hover:underline" href={getRelativeLocaleUrl(locale, "search")}>
        {english ? "Search" : "搜索"}
      </a>
    </nav>
  </div>
</footer>
